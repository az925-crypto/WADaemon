<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabModul"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modul"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/moduleList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Modul"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama modul" />

        <EditText
            android:id="@+id/addName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Contoh: Auto Reply" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perintah (pisah spasi)" />

        <EditText
            android:id="@+id/addCmds"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint=".halo .pagi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF7E0"
            android:padding="10dp"
            android:text="Modul boleh memakai library apa pun, termasuk yang berat atau native. Aplikasi menampilkan peringatan bila modul terdeteksi berat, tapi tetap dipasang dan dijalankan." />

        <Button
            android:id="@+id/btnAddModule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Pasang Modul" />
    </LinearLayout>
</ScrollView>
